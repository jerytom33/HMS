# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MongoDB Atlas credentials
atlas-credentials.env

# Generated by Payload at dev/CLI time; enabling it surfaces existing type errors
payload-types.ts

# WhatsApp bot / cron secrets (also set in Vercel)
bot-credentials.env

hms-otp-webhook.env
